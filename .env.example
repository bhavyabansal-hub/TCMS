# ---- Database (MySQL 8.4 — the ONLY supported engine) ----------------------
# TWO-USER MODEL (do not point both URLs at one user):
#   DATABASE_URL  the APP RUNTIME user — DML ONLY (SELECT, INSERT, UPDATE,
#                 DELETE). The Prisma client queries through this URL; it must
#                 have NO DDL rights.
#   DIRECT_URL    the SCHEMA-MIGRATION user — holds the DDL rights (CREATE,
#                 DROP, INDEX, ALTER, ...). Used ONLY by `prisma migrate
#                 deploy`; the app never touches it at runtime. IT provisions
#                 both users; never run the app with the migrate credentials.
DATABASE_URL=mysql://tcms_app:change-me@db.host:3306/tcms
DIRECT_URL=mysql://tcms_migrate:change-me@db.host:3306/tcms

# SCHEMA IS APPLIED IN EXACTLY ONE WAY:
#   npx prisma migrate deploy          # run as the DIRECT_URL migrate user
# The versioned migrations in prisma/migrations/ create the full schema
# (baseline 20261015034822_init_mysql carries utf8mb4_unicode_ci everywhere,
# utf8mb4_bin on users.password_hash + refresh_tokens.token, and the JSON
# expression defaults). There is NO db push / setup.sql / fixup-script path
# anymore — a second `migrate deploy` is a no-op ("No pending migrations").
# Verify after deploy: SELECT migration_name, applied_steps_count
# FROM _prisma_migrations;  → every row finished with no failures.

# ---- DAILY BACKUPS (scheduler: node scripts/backup-scheduler.mjs) ----------
# Backups run as the READ-ONLY tcms_backup user (SELECT + SHOW VIEW + TRIGGER
# only — created next to tcms_app/tcms_migrate; ask IT for it). Never the app
# or migrate user. Credentials travel in a chmod-600 defaults file — never on
# a command line (ps-safe, verified by scripts/backup-test.mjs).
#   BACKUP_DATABASE_URL  REQUIRED on the real server (the sandbox falls back
#                        to tcms_backup@127.0.0.1:5500/tcms_test). mysql://
#                        URL, percent-encoded. The scheduler alerts every
#                        manage_users holder in-app when a backup fails or
#                        the newest valid backup is > 26 h old — for that it
#                        uses DATABASE_URL (app user, DML) and needs the
#                        `mysql` client binary on the app host.
#   BACKUP_AT            daily run time, "HH:MM" local    (default 02:30)
#   BACKUP_KEEP          newest N files kept              (default 14)
#   BACKUP_SHIP_CMD      optional off-server copy command ({file} placeholder)
# Verify nightly: `ls -lt backups/ | head` — a file younger than 26 h, and
# `gunzip -c <file> | tail -1` ends with "Dump completed". Restore drill:
# bash scripts/restore-mysql.sh --file backups/<file>.sql.gz (`docs/deploy/operations-runbook.md` §2.1).
# BACKUP_DATABASE_URL=mysql://tcms_backup:change-me@db.host:3306/tcms

JWT_SECRET=change-me-to-a-long-random-string

# ---- PRODUCTION STARTUP GUARD (TCMS_DEPLOY_ENV) — read this before go-live --
# IT sets EXACTLY ONE extra variable on the real server:
#   TCMS_DEPLOY_ENV=production
# Never set it in the sandbox (or any non-production box). The app AND the
# notifications WS service then REFUSE TO START (exit 1, before any port is
# opened) while any required secret is missing, shorter than 32 characters
# (generated secrets), or a known placeholder (sandbox defaults such as
# ChangeMe_local_only / mock-login-secret, the .env.example examples, and the
# generic words changeme / secret / password). DATABASE_URL must be mysql://,
# use a NON-ROOT user with a real password, and must NOT point at the sandbox
# MySQL (127.0.0.1:5500). TCMS_ENABLE_SEED must be off. Optional-channel
# secrets (Telegram, SMTP, Crew Desk) are checked only when they are set.
# Errors name the VARIABLE and the REASON — never a value.
#
# WHY NOT NODE_ENV: `next start` sets NODE_ENV=production by itself (the
# sandbox would break), while a plain `bun index.ts` for the WS service sets
# no NODE_ENV at all (a guard keyed on it would silently never fire on the
# real server). TCMS_DEPLOY_ENV is explicit and unambiguous.
#
# GO-LIVE SMOKE TEST — check the startup line in BOTH process logs:
#   [TCMS] production guard ACTIVE          <- required on the real server
#   [TCMS] production guard OFF (sandbox mode) <- switch forgotten; DO NOT
#                                                   go live until it reads ACTIVE
# Every guarded process prints exactly one such line at boot.
# TCMS_DEPLOY_ENV=production

# ---- PRODUCTION DB SETTINGS GUARD (runs with TCMS_DEPLOY_ENV=production) ---
# A SECOND boot gate: after the secrets pass, the app verifies the MySQL
# SERVER it connects to (task db-settings-guard-1). It reads the SESSION
# @@sql_mode / @@time_zone / @@character_set_server / @@transaction_isolation
# on the app's own connection plus the app schema's default charset
# (information_schema.SCHEMATA) and REFUSES TO START (exit 1, before any port
# opens) when:
#   - sql_mode lacks STRICT_TRANS_TABLES or ONLY_FULL_GROUP_BY
#     (full 8.4 default: ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,
#      NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,
#      NO_ENGINE_SUBSTITUTION — set it in my.cnf so it survives restarts)
#   - time_zone is not '+00:00' or 'UTC'  (SYSTEM/host-clock servers refuse)
#   - character_set_server is not utf8mb4
#   - the schema default charset (SCHEMATA DEFAULT_CHARACTER_SET_NAME) is not
#     utf8mb4, or the DATABASE_URL schema does not exist
# UNREACHABLE database: 5 connection attempts, 3 s apart, then
#   exit 1 "database unreachable (<host>:<port>)" — host:port only, no
#   credentials. Covers the "app boots before the DB" container race.
# transaction_isolation is PRINTED on every boot but never fails it (the
# concurrency task owns that decision).
# GO-LIVE SMOKE TEST adds one grep to the app log:
#   [TCMS] db-settings OK: sql_mode=... time_zone=+00:00 ... <- required
#   [TCMS] db-settings guard OFF (sandbox mode)  <- TCMS_DEPLOY_ENV forgotten
# Refusals name the SETTING and its VALUE (settings are not secrets —
# credentials still never print). See src/lib/server/db-settings-guard.ts.

# Extra hosts trusted for Origin checking (CSRF), comma-separated (optional).
# TCMS_EXTRA_ALLOWED_HOSTS=preview-<bot-id>.space-z.ai

# Explicit public origin baked into Crew Desk comment links (optional; when
# unset the request's Origin/host headers are used).
# TCMS_PUBLIC_ORIGIN=https://tcms.yourcompany.com

# ---- First-run seeding (SECURITY: keep OFF in production) -------------------
# /api/seed only runs when this is true; it no-ops once any user exists.
# TCMS_ENABLE_SEED=true

# ---- Self-signup switch (SECURITY: both flags default OFF) ------------------
# Controls whether strangers can create their own accounts at /login.
# Registration ALWAYS creates the least-privileged 'viewer' role — any
# client-supplied "role" is ignored server-side; roles are changed only
# through /api/users (manage_users permission).
#
# TCMS_ALLOW_SIGNUP        — SERVER gate, read at RUNTIME per request.
#   true                     POST /api/auth?path=register works (viewer only).
#   false / unset            register answers 403. Fail-closed: UNSET = OFF.
#
# NEXT_PUBLIC_ALLOW_SIGNUP — CLIENT gate, BAKED IN AT BUILD TIME.
#   true                     /login shows the "Create account" tab.
#   false / unset            tab + footer link are not rendered.
#
# !! Change BOTH flags TOGETHER and REBUILD the app (npm run build) —
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# editing the env without a rebuild leaves the UI stale (and a rebuild
# without the server flag would show a tab that 403s). Verify after any
# change: register must behave exactly like the tab promises.
#
# TCMS_ALLOW_SIGNUP=false
# NEXT_PUBLIC_ALLOW_SIGNUP=false
#
# Production first-run: the first VP comes from scripts/create-first-vp.mjs
# (`docs/deploy/operations-runbook.md` §6), never from public registration or the demo seed. Keep
# TCMS_ENABLE_SEED off and BOTH signup flags false in production.

# ---- Maintenance mode + login abuse limit -----------------------------------
# TCMS_READ_ONLY=true -> every API write (POST/PUT/PATCH/DELETE) answers 503
# "read-only maintenance mode"; sign-in, token refresh and sign-out keep working
# so people can still read. Read at boot: restart the app to switch it.
# TCMS_READ_ONLY=false
#
# Per-IP login limit (in memory, single instance): after this many FAILED
# sign-ins from one client IP inside the window, that IP gets 429 until the
# window ends. The IP is the last X-Forwarded-For entry (set by nginx).
# TCMS_LOGIN_IP_MAX_FAILURES=30
# TCMS_LOGIN_IP_WINDOW_SECONDS=900

# ---- Logging ----------------------------------------------------------------
# Rotating file logs land in ./logs (app-YYYY-MM-DD.log + error-YYYY-MM-DD.log).
# LOG_DIR=logs
# LOG_RETENTION_DAYS=14
# Print every SQL statement (prisma:query lines) — debugging only, off by default.
# TCMS_LOG_SQL=false
#
# DEDICATED LOGS BOT — separate from the user-notification TELEGRAM_BOT_TOKEN
# below. When both keys are set, every warn/error is mirrored to that Telegram
# chat (batched + throttled so a burst cannot flood the chat).
# TELEGRAM_LOG_BOT_TOKEN=123456:ABC-your-log-bot-token
# TELEGRAM_LOG_CHAT_ID=-1001234567890
# TELEGRAM_LOG_LEVEL=error            # debug | info | warn | error
# TELEGRAM_LOG_MIN_INTERVAL_MS=2000

# ---- Outbound notification delivery (both channels are OPTIONAL) ----------
# These are the EXACT names the app reads (src/lib/server/config.ts ->
# src/lib/server/delivery.ts). Unset channel = skipped with one log line; a
# delivery failure is logged and never breaks the user's action.
# Test after filling them (sends one real message, prints OK or the error):
#   node scripts/send-test-notification.mjs --email=you@company.com --chat=<chat id>
#   node scripts/send-test-notification.mjs --check     # shows what is set, sends nothing
#
# Email (nodemailer SMTP). SMTP_HOST switches the channel on.
# SMTP_HOST=smtp.yourcompany.com
# SMTP_PORT=587              # 587 = STARTTLS (default) · 465 = implicit TLS (implies secure)
# SMTP_SECURE=false          # "true" only for implicit TLS (port 465)
# SMTP_USER=tcms@yourcompany.com   # leave empty for an unauthenticated relay
# SMTP_PASS=app-password           # SECRET — never commit, never paste in tickets
# SMTP_FROM=tcms@yourcompany.com   # sender address the relay accepts (default tcms@localhost)
#
# Telegram (Bot API, https://api.telegram.org). TELEGRAM_BOT_TOKEN switches it on.
# Create the bot with @BotFather; each user stores their own chat id in
# Settings -> Profile ("Telegram chat ID") and turns the Telegram switch on.
# A user finds their chat id by messaging the bot, then opening
# https://api.telegram.org/bot<token>/getUpdates (message.chat.id).
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token   # SECRET
# (The separate TELEGRAM_LOG_* keys above are the ops log bot, not user notifications.)
#
# In-app realtime push (loopback broadcast endpoint of the WS mini-service).
# WS_NOTIFY_URL=http://127.0.0.1:3004/notify
#
# WS_NOTIFY_SECRET — shared secret for the realtime notification service.
# REQUIRED for live notifications: the app signs 60-second single-purpose WS
# tickets with it (GET /api/auth?path=ws-ticket) and the WS mini-service
# (mini-services/notifications) verifies them — plus the app's /notify
# broadcasts — against the same value. FAIL-CLOSED: when unset, no socket is
# ever joined to any room and every broadcast is refused (the app degrades
# to refresh-visible delivery: the DB row shows up on the client's next list
# fetch — page load, socket reconnect, tab re-visible; there are NO polling
# timers).
#
# !! Generate a FRESH random value for EVERY deployment: openssl rand -hex 24
# NEVER reuse the sandbox/development value in production (the sandbox .env
# is excluded from the canonical zip precisely so its value cannot leak; a
# reused value would let anyone who saw it mint valid WS tickets in prod).
# WS_NOTIFY_SECRET=<fresh openssl rand -hex 24 output>

# ---- Realtime service deployment (mini-services/notifications) --------------
# How browsers reach the socket service. Full reverse-proxy recipes (nginx /
# Apache / IIS + firewall rules): docs/deploy/reverse-proxy-websocket.md
#
# CLIENT — NEXT_PUBLIC_* values are BAKED AT BUILD TIME: change + REBUILD.
# NEXT_PUBLIC_WS_URL   Socket server URL. '' (default) = same origin as the
#                        app — the recommended setup behind a reverse proxy.
#                        Sandbox platform gateway instead proxies by query
#                        param: NEXT_PUBLIC_WS_URL=/?XTransformPort=3003
# NEXT_PUBLIC_WS_PATH  socket.io path. Default '/socket.io/'; the sandbox
#                        gateway needs '/'. MUST match WS_SOCKET_PATH.
#
# SERVICE — read from process.env at RUNTIME (no rebuild needed):
# WS_PORT           Public socket listener. Default 3003. Never expose
#                     publicly (firewall: only 80/443; see deploy doc).
# WS_SOCKET_PATH    socket.io path. Default: '/socket.io/' when
#                     TCMS_DEPLOY_ENV=production, '/' otherwise (sandbox
#                     gateway). MUST match NEXT_PUBLIC_WS_PATH.
# WS_CORS_ORIGIN    Comma-separated browser origins allowed to connect,
#                     e.g. https://tcms.yourcompany.com. PRODUCTION
#                     REFUSES TO START when TCMS_DEPLOY_ENV=production and
#                     the value is unset or '*' (fail-closed).
# NEXT_PUBLIC_WS_URL=
# NEXT_PUBLIC_WS_PATH=
# WS_PORT=3003
# WS_SOCKET_PATH=
# WS_CORS_ORIGIN=

# ---- Crew Desk integration (all values below are PLACEHOLDERS) -------------
# API base. Leave unset to let scripts/start-tcms.sh boot the local mock and
# point this at http://127.0.0.1:3010 automatically.
# CREWDESK_BASE_URL=https://api.crewdesk.shipgl.in
#
# Sign-in — choose ONE:
#   (a) fixed token:
# CREWDESK_AUTH=token
# CREWDESK_TOKEN=<bearer token from the Crew Desk admins>
#   (b) email/password login (JWT kept in memory only; refreshed before
#       expiry, once more after any 401; 3 failures pause logins 15 min):
# CREWDESK_AUTH=login
# CREWDESK_LOGIN_EMAIL=tcms.service@yourcompany.com
# CREWDESK_LOGIN_PASSWORD=<service account password>
# CREWDESK_LOGIN_PATH=/api/login
#
# The shared service account's Crew Desk user id — sent as user_id with EVERY
# comment. Never a real person's id. Warns at startup when a JWT credential's
# user_id claim disagrees.
# CREWDESK_USER_ID=<shared account id>
#
# Modes: manual = no Crew Desk calls at all (generate + copy the comment);
# test = comments only to the ONE designated ticket; live = any ticket.
# Anything unset/unrecognized stays in the guarded test mode.
# CREWDESK_MODE=test
# Owner-designated TEST ticket for this deployment (dev backend):
# CREWDESK_TEST_TICKET_ID=1355
# Production would designate its own single ticket via this same variable (dev uses 1355).
# CREWDESK_TIMEOUT_MS=8000

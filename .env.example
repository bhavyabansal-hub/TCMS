# TCMS settings
# 1. Copy this file to .env   2. Fill the keys   3. Restart the app
# NEXT_PUBLIC_* keys: run `npm run build` again after a change.
# Empty = default / off. Never commit .env.

# ==== Required (every machine) ====
# App database (app user)
DATABASE_URL=mysql://tcms_app:<password>@127.0.0.1:5500/tcms_test
# Migration database (migrate user)
DIRECT_URL=mysql://tcms_migrate:<password>@127.0.0.1:5500/tcms_test
# Session secret, 32+ random chars: openssl rand -hex 32
JWT_SECRET=

# ==== Required on the live server ====
# Set to: production
TCMS_DEPLOY_ENV=
# Public site URL, e.g. https://tcms.company.com
TCMS_PUBLIC_ORIGIN=
# Same URL as above (allowed for live updates)
WS_CORS_ORIGIN=
# Live-update secret, 32+ random chars: openssl rand -hex 24
WS_NOTIFY_SECRET=
# Backup database (read-only user)
BACKUP_DATABASE_URL=
# Backup folder, e.g. /opt/tcms/backups
TCMS_BACKUP_DIR=

# ==== Email (SMTP) ====
# Mail server (empty = no email)
SMTP_HOST=
# 587 or 465 (default 587)
SMTP_PORT=
# true only for port 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender address (needed when SMTP_HOST is set)
SMTP_FROM=
# default 8000
SMTP_TIMEOUT_MS=

# ==== Telegram ====
# Bot token from @BotFather (empty = no Telegram)
TELEGRAM_BOT_TOKEN=
# default https://api.telegram.org
TELEGRAM_API_URL=
# default 5000
TELEGRAM_TIMEOUT_MS=
# Ops log bot (empty = off)
TELEGRAM_LOG_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
# debug, info, warn or error (default error)
TELEGRAM_LOG_LEVEL=
# default 2000
TELEGRAM_LOG_MIN_INTERVAL_MS=

# ==== Crew Desk ====
# API URL (empty = off)
CREWDESK_BASE_URL=
# manual (off), test (one ticket) or live (default test)
CREWDESK_MODE=
# token or login
CREWDESK_AUTH=
# Needed when CREWDESK_AUTH=token
CREWDESK_TOKEN=
# Needed when CREWDESK_AUTH=login
CREWDESK_LOGIN_EMAIL=
CREWDESK_LOGIN_PASSWORD=
# default /api/login
CREWDESK_LOGIN_PATH=
# Service account user id (needed to post comments)
CREWDESK_USER_ID=
# Ticket used in test mode (default 1355)
CREWDESK_TEST_TICKET_ID=
# default 8000
CREWDESK_TIMEOUT_MS=

# ==== Backups ====
# Daily time HH:MM (default 02:30)
BACKUP_AT=
# Files kept (default 14)
BACKUP_KEEP=
# Copy off-server, e.g. rsync -a {file} backup-host:/srv/tcms/
BACKUP_SHIP_CMD=

# ==== Sign-in and accounts ====
# default 15
TCMS_ACCESS_TOKEN_MINUTES=
# default 7
TCMS_REFRESH_TOKEN_DAYS=
# Failed sign-ins before an email is locked (default 5)
TCMS_LOGIN_MAX_FAILURES=
# default 60
TCMS_LOGIN_LOCK_SECONDS=
# Failed sign-ins per IP (default 30)
TCMS_LOGIN_IP_MAX_FAILURES=
# default 900
TCMS_LOGIN_IP_WINDOW_SECONDS=
# Self-signup: keep false on the live server (change both, then rebuild)
TCMS_ALLOW_SIGNUP=
NEXT_PUBLIC_ALLOW_SIGNUP=

# ==== Live updates (WebSocket) ====
# Browser URL of the socket service (empty = same site)
NEXT_PUBLIC_WS_URL=
# default /socket.io/ (must match WS_SOCKET_PATH)
NEXT_PUBLIC_WS_PATH=
WS_SOCKET_PATH=
# default 3003
WS_PORT=
# default 3004
NOTIFY_PORT=
# default http://127.0.0.1:3004/notify
WS_NOTIFY_URL=
# default 3000
WS_NOTIFY_TIMEOUT_MS=

# ==== Tuning (leave empty) ====
# Extra trusted hosts, comma-separated
TCMS_EXTRA_ALLOWED_HOSTS=
# DB connections per process (default 40)
TCMS_DB_CONNECTION_LIMIT=
# default 10
TCMS_DB_POOL_TIMEOUT=
# default 2048
TCMS_MAX_JSON_BODY_KB=
# default 10
TCMS_MAX_UPLOAD_MB=
# default logs
LOG_DIR=
# default 14
LOG_RETENTION_DAYS=
# default 1000
TCMS_SLOW_REQUEST_MS=

# ==== Dev / maintenance only (keep off on the live server) ====
# Demo data (true only on a dev machine)
TCMS_ENABLE_SEED=
# Maintenance: true = read-only
TCMS_READ_ONLY=
# Print every SQL query (debugging)
TCMS_LOG_SQL=

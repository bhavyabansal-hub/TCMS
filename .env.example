# TCMS settings — .env is the ONE place for every URL, key, password, host, port and
# timeout. Copy this file to .env, fill the REQUIRED keys, leave optional keys empty to
# use the default. To change any setting: edit .env, then restart the app (and rebuild
# for NEXT_PUBLIC_* keys). Never commit .env. Tidy an existing .env with
# `node scripts/clean-env.mjs` (dry run) / `--write` (backup .env.bak first).
# Each key: what it is · example · required or optional (default).

# ==== App ====
# Real-server switch: turns on the startup guards, Secure cookies, required app URL. Example: production. Optional (empty = dev/sandbox).
TCMS_DEPLOY_ENV=
# Public app URL used in links (Crew Desk comments). Example: https://tcms.company.com. Required in production, optional in dev.
TCMS_PUBLIC_ORIGIN=
# Extra hosts trusted by the CSRF Origin check, comma-separated. Example: tcms-internal.company.com. Optional.
TCMS_EXTRA_ALLOWED_HOSTS=
# Allows /api/seed to create demo data (only while no user exists). Example: true. Optional (default false; must be off in production).
TCMS_ENABLE_SEED=
# Maintenance mode: every write answers 503, sign-in still works. Example: true. Optional (default false).
TCMS_READ_ONLY=
# Browser URL of the realtime socket service ('' = same site as the app). Example: /?XTransformPort=3003. Optional, build-time (rebuild after change).
NEXT_PUBLIC_WS_URL=
# socket.io path the browser uses; must match WS_SOCKET_PATH. Example: /socket.io/. Optional (default /socket.io/), build-time.
NEXT_PUBLIC_WS_PATH=
# Port of the realtime socket service (mini-services/notifications). Example: 3003. Optional (default 3003).
WS_PORT=
# Loopback port of the service's /notify broadcast endpoint. Example: 3004. Optional (default 3004).
NOTIFY_PORT=
# socket.io path of the service; must match NEXT_PUBLIC_WS_PATH. Example: /socket.io/. Optional (default /socket.io/ in production, / otherwise).
WS_SOCKET_PATH=
# Browser origins allowed to open a socket, comma-separated. Example: https://tcms.company.com. Required in production.
WS_CORS_ORIGIN=
# Where the app posts realtime broadcasts. Example: http://127.0.0.1:3004/notify. Optional (default http://127.0.0.1:3004/notify).
WS_NOTIFY_URL=

# ==== Database ====
# App database URL — the DML-only app user (SELECT/INSERT/UPDATE/DELETE). Example: mysql://tcms_app:<password>@127.0.0.1:5500/tcms_test. Required.
DATABASE_URL=mysql://tcms_app:<password>@127.0.0.1:5500/tcms_test
# Migration user URL (DDL rights), used only by `npx prisma migrate deploy`. Example: mysql://tcms_migrate:<password>@127.0.0.1:5500/tcms_test. Required for migrations.
DIRECT_URL=mysql://tcms_migrate:<password>@127.0.0.1:5500/tcms_test

# ==== Security / Sessions ====
# Signs the session tokens; random 32+ characters (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). Example: 64 hex chars. Required.
JWT_SECRET=
# Shared secret between the app and the realtime service (WS tickets + broadcasts); openssl rand -hex 24. Example: 48 hex chars. Required in production (empty = no live push).
WS_NOTIFY_SECRET=
# Access token lifetime in minutes. Example: 15. Optional (default 15).
TCMS_ACCESS_TOKEN_MINUTES=
# Refresh token (stay-signed-in) lifetime in days. Example: 7. Optional (default 7).
TCMS_REFRESH_TOKEN_DAYS=
# Failed sign-ins per email before that email is locked. Example: 5. Optional (default 5).
TCMS_LOGIN_MAX_FAILURES=
# How long a locked email waits, in seconds. Example: 60. Optional (default 60).
TCMS_LOGIN_LOCK_SECONDS=
# Failed sign-ins per client IP inside the window before 429. Example: 30. Optional (default 30).
TCMS_LOGIN_IP_MAX_FAILURES=
# Length of that per-IP window in seconds. Example: 900. Optional (default 900).
TCMS_LOGIN_IP_WINDOW_SECONDS=
# Server switch for self-signup (new accounts are always viewer). Example: false. Optional (default false; keep false in production).
TCMS_ALLOW_SIGNUP=
# Shows the "Create account" tab; change together with TCMS_ALLOW_SIGNUP. Example: false. Optional (default false), build-time.
NEXT_PUBLIC_ALLOW_SIGNUP=

# ==== Email (SMTP) ====
# SMTP server; setting it switches email notifications on. Example: smtp.company.com. Optional (empty = no email).
SMTP_HOST=
# SMTP port: 587 = STARTTLS, 465 = implicit TLS. Example: 587. Optional (default 587).
SMTP_PORT=
# true only for implicit TLS (port 465). Example: false. Optional (default false; port 465 implies true).
SMTP_SECURE=
# SMTP login user (empty for an unauthenticated relay). Example: tcms@company.com. Optional.
SMTP_USER=
# SMTP password — SECRET. Example: app-password. Required in production when SMTP_HOST is set.
SMTP_PASS=
# Sender address the relay accepts. Example: tcms@company.com. Required when SMTP_HOST is set.
SMTP_FROM=
# Timeout for each SMTP step in milliseconds. Example: 8000. Optional (default 8000).
SMTP_TIMEOUT_MS=

# ==== Telegram ====
# Bot API base URL (both bots). Example: https://api.telegram.org. Optional (default https://api.telegram.org).
TELEGRAM_API_URL=
# User-notification bot token from @BotFather — SECRET; users store their chat id in Settings -> Profile. Example: 123456:ABC-token. Optional (empty = no Telegram).
TELEGRAM_BOT_TOKEN=
# Timeout for each Telegram request in milliseconds. Example: 5000. Optional (default 5000).
TELEGRAM_TIMEOUT_MS=

# ==== Crew Desk ====
# Crew Desk API base URL; the ONLY host TCMS ever calls for Crew Desk. Example: https://api.crewdesk.company.com. Optional (empty = integration off).
CREWDESK_BASE_URL=
# On/off and safety mode: manual = off (no calls, copy the comment by hand), test = only CREWDESK_TEST_TICKET_ID, live = any ticket. Example: test. Optional (default test).
CREWDESK_MODE=
# Sign-in method: token or login (empty = token when CREWDESK_TOKEN is set). Example: token. Optional.
CREWDESK_AUTH=
# Fixed bearer token from the Crew Desk admins — SECRET. Example: <token>. Required when CREWDESK_AUTH=token.
CREWDESK_TOKEN=
# Service-account email for password sign-in. Example: tcms.service@company.com. Required when CREWDESK_AUTH=login.
CREWDESK_LOGIN_EMAIL=
# Service-account password — SECRET. Example: <password>. Required when CREWDESK_AUTH=login.
CREWDESK_LOGIN_PASSWORD=
# Login endpoint path on the Crew Desk API. Example: /api/login. Optional (default /api/login).
CREWDESK_LOGIN_PATH=
# The shared service account's Crew Desk user id, sent with every comment. Example: 7001. Required to post comments.
CREWDESK_USER_ID=
# The one ticket test mode may comment on. Example: 1355. Optional (default 1355).
CREWDESK_TEST_TICKET_ID=
# Timeout for each Crew Desk request in milliseconds. Example: 8000. Optional (default 8000).
CREWDESK_TIMEOUT_MS=

# ==== Backups ====
# Read-only backup user URL for mysqldump (scripts/backup-scheduler.mjs). Example: mysql://tcms_backup:<password>@db.host:3306/tcms. Required on the real server.
BACKUP_DATABASE_URL=
# Daily backup time, HH:MM local. Example: 02:30. Optional (default 02:30).
BACKUP_AT=
# Newest backup files kept. Example: 14. Optional (default 14).
BACKUP_KEEP=
# Optional off-server copy command; {file} is replaced by the backup path. Example: scp {file} backup@host:/backups/. Optional.
BACKUP_SHIP_CMD=
# Folder the app watches for stale backups (needed for the standalone build). Example: /opt/tcms/backups. Optional (default <app folder>/backups).
TCMS_BACKUP_DIR=

# ==== Performance ====
# Database connections per app process (keep instances x limit under MySQL max_connections). Example: 40. Optional (default 40).
TCMS_DB_CONNECTION_LIMIT=
# Seconds a request waits for a free connection before 503 "server busy". Example: 10. Optional (default 10).
TCMS_DB_POOL_TIMEOUT=
# Largest accepted JSON request body in KB (bigger = 413). Example: 2048. Optional (default 2048).
TCMS_MAX_JSON_BODY_KB=
# Largest wiki file upload in MB. Example: 10. Optional (default 10).
TCMS_MAX_UPLOAD_MB=
# Timeout for one realtime broadcast in milliseconds. Example: 3000. Optional (default 3000).
WS_NOTIFY_TIMEOUT_MS=

# ==== Logging ====
# Folder for the rotating log files. Example: logs. Optional (default logs).
LOG_DIR=
# Days to keep log files. Example: 14. Optional (default 14).
LOG_RETENTION_DAYS=
# Print every SQL statement (debugging only). Example: false. Optional (default false).
TCMS_LOG_SQL=
# Requests slower than this (ms) are logged as warnings. Example: 1000. Optional (default 1000).
TCMS_SLOW_REQUEST_MS=
# Ops log bot token (separate from TELEGRAM_BOT_TOKEN) — SECRET. Example: 123456:ABC-token. Optional (empty = off).
TELEGRAM_LOG_BOT_TOKEN=
# Chat that receives the ops log lines. Example: -1001234567890. Optional (needed with TELEGRAM_LOG_BOT_TOKEN).
TELEGRAM_LOG_CHAT_ID=
# Lowest level sent to that chat: debug, info, warn or error. Example: error. Optional (default error).
TELEGRAM_LOG_LEVEL=
# Minimum milliseconds between two log messages (burst guard). Example: 2000. Optional (default 2000).
TELEGRAM_LOG_MIN_INTERVAL_MS=

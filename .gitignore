# ============================================================================
# TCMS — .gitignore
# RULE: only real source code belongs in the repository. Everything that is
# generated, downloaded, machine-specific or SECRET is ignored below.
# ============================================================================

# ---- SECRETS: environment files (the #1 rule — never commit these) ----
.env
.env.*
.env.local
.env.production
!.env.example

# ---- Dependencies (recreated any time with `npm install`) ----
node_modules/
/.pnp
.pnp.*

# ---- Next.js build output (recreated with `npm run build`) ----
/.next/
/out/
/build/

# ---- Vercel CLI local state ----
.vercel

# ---- Logs & temp output ----
logs/
*.log
*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- TypeScript incremental build ----
*.tsbuildinfo
next-env.d.ts

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE folders ----
.idea/
.vscode/
*.swp
*.swo

# ---- Local databases & embedded PostgreSQL data (NEVER commit live data) ----
/db/
scripts/pg-sandbox/data/
*.sqlite
*.sqlite3

# ---- Archives & downloads (no binaries in the repo) ----
*.zip
*.tar.gz
*.tgz
/download/

# ---- Test coverage & tooling artifacts ----
/coverage/
/upload/
/tool-results/

# ---- Development-session artifacts (never part of the product) ----
/agent-ctx/
/skills/
/study_project/
/.zscripts/
.z-ai-config
.claude/settings.local.json
*.zbak
/local-*
dev.log

# DB backups contain full user data — never commit
backups/

# ---- Legacy staging copy: PG sandbox lives at scripts/pg-sandbox/ (no duplicates) ----
scripts/tcms-package/scripts/pg-sandbox/

# ---- Sandbox-side self-heal (untracked: contains local dev secret, not shippable) ----
scripts/boot-selfheal.sh
logs-start.log


scripts/pg-sandbox/
scripts/pg-client/
